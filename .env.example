# Docker local stack only. `pnpm local:start` copies this to private .env.local
# when it does not exist. Existing .env.local files are never overwritten.
# Keep server keys here; NEVER add a NEXT_PUBLIC_ prefix to a private key.
# The app can start without a key; live voice and AI generation require one.
GEMINI_API_KEY=

# Optional model overrides. Availability depends on the provider/account.
LIVE_MODEL=gemini-3.8-live
FAST_MODEL=gemini-3.8-flash
SCENE_MODEL=gemini-4-argon
GAME_MODEL=gemini-4-argon
GAME_MODEL_LOCATION=global
HERO_MODEL=gemini-nano-banana-2.1
PROP_MODEL=gemini-3.1-flash-lite-image
COMPANION_IMAGE_MODEL=gemini-nano-banana-2.1

# Parents can start the Family plan without paying (1) or not at all (0) while
# Stripe is not configured. Stripe takes over whenever its keys are set.
SUBSCRIPTIONS_WITHOUT_PAYMENT=1

# After editing a server key/model: pnpm local:reload-key
# Compose sets the demo project, emulator hosts and ports; do not copy cloud
# credentials into this file. Web NEXT_PUBLIC_* settings are build-time values
# in Dockerfile.local. apps/web/.env.example is for direct Next development.
