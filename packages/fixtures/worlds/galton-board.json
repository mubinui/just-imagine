  "rules": [
    {
      "id": "release_ball",
      "when": {
        "event": "tap",
        "target": "release"
      },
      "then": [
        {
          "action": "spawn",
          "template": "ball",
          "at": {
            "x": 8.12,
            "y": 0.6
          },
          "count": 1
        }
      ],
      "concept": "probability",
      "once": false
    },
    {
      "id": "drop_ball",
      "when": {
        "event": "timer",
        "everySeconds": 3
      },
      "then": [
        {
          "action": "spawn",
          "template": "ball",
          "at": {
            "x": 8.12,
            "y": 0.6
          },
          "count": 1
        }
      ],
      "concept": "probability",
      "once": false
    },
    {
      "id": "peg_touch",
      "when": {
        "event": "collision",
        "a": "ball",
        "b": "peg"
      },
      "then": [
        {
          "action": "say",
          "text": "Each peg can nudge a ball left or right. Watch the landing counts grow."
        }
      ],
      "concept": "probability",
      "once": true
    }
  ],
  "learning": {
    "concepts": ["probability", "graph"],
    "prediction": {
      "question": "Will every ball necessarily land in the same bin?",
      "options": ["Yes, always", "No, paths can differ"],
      "correctIndex": 1,
      "concept": "probability"
    },
    "dials": [],
    "heroEntityId": "ball"
  },
  "narration": {
    "intro": "Watch balls tumble through the pegs. Tap the round button to add a ball, then compare the four bins."
  },
  "variables": {
    "time_scale": {
      "label": "Watch speed",
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "value": 1,
      "unit": "\u00d7",
      "binds": {
        "kind": "timeScale"
      }
    }
  },
  "visuals": [
    {
      "type": "histogram",
      "id": "landings",
      "title": "Balls in each bin",
      "bins": 4,
      "source": {
        "tag": "ball",
        "prop": "x"
      }
    }
  ],
  "challenges": [
    {
      "id": "collect_six",
      "goal": "Collect six landings and compare the bins",
      "check": {
        "event": "histogramFilled",
        "id": "landings",
        "count": 6
      },
      "hint": "Let each ball settle. The tallest bar has the most landings.",
      "concept": "probability",
      "reward": [
        {
          "action": "celebrate",
          "style": "confetti"
        }
      ]
    }
