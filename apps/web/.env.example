NEXT_PUBLIC_FAKE=1
NEXT_PUBLIC_GATEWAY_URL=ws://127.0.0.1:8787
NEXT_PUBLIC_API_URL=http://localhost:8081
# Direct Next development only; Docker uses build-time values in Dockerfile.local.
# Real mode: set NEXT_PUBLIC_FAKE=0 and provide public Firebase project configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_EMULATOR=0
# Server Admin uses ADC; local emulators can use:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_CLOUD_PROJECT=demo-just-imagine
# Next automatically reads apps/web/.env.local. Server service `tsx` commands
# do not auto-load env files; explicitly export their variables before starting.
# Optional final Rive files: <base>/<characterId>.riv, state machine Character.
NEXT_PUBLIC_CHARACTER_ASSET_BASE_URL=
