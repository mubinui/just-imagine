GOOGLE_CLOUD_PROJECT=demo-just-imagine
# Explicit local adapters require both emulators and a demo-* project.
LOCAL_DEV=1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=8081
WEB_URL=http://localhost:3000
# Optional Stripe test mode. Keep secrets outside Git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional personal chibi generation. Server only; never use a NEXT_PUBLIC prefix.
# Set an AI Studio key, or COMPANION_VERTEX=1 with ADC and a real project.
GEMINI_API_KEY=
COMPANION_VERTEX=0
COMPANION_IMAGE_MODEL=gemini-nano-banana-2.1
FAST_MODEL=gemini-3.8-flash

# This example is not auto-loaded by tsx. Export these variables explicitly
# before `pnpm --filter @just-imagine/api dev`. Prefer root `pnpm local:start`
# for the complete web/API/builder/gateway/emulator setup.
# Production uses ADC + COMPANION_VERTEX=1, no emulator hosts or LOCAL_DEV.
# Durable Cloud Tasks configuration (never leave these blank in a cloud env):
# API_AUDIENCE=https://<api-service>
# BUILDER_URL=https://<builder-service>
# TASK_SERVICE_ACCOUNT=<tasks-service-account-email>
# BUILDER_QUEUE=world-builds
# DELETION_QUEUE=deletions
