    "game": {
      "script": {
        "apiVersion": 1,
        "source": "let portalOn = false; const PAD_LEFT = { x: 4, y: 3 }; const PAD_RIGHT = { x: 12, y: 3 }; const BOLT_OFF = { x: 8, y: 6 }; const BOLT_ON = { x: 8, y: 4.5 }; game.move(\"ball\", PAD_LEFT); game.move(\"bolt_toy\", BOLT_OFF); game.on(\"tap\", (e) => { if (!e.target) return; const id = e.target.id; const tags = e.target.tags || []; if (id === \"bolt_toy\" || tags.includes(\"bolt\")) { portalOn = !portalOn; if (portalOn) { game.move(\"bolt_toy\", BOLT_ON); game.sound(\"ding\"); game.say(\"Portal is on! Tap the ball to teleport!\"); } else { game.move(\"bolt_toy\", BOLT_OFF); game.sound(\"pop\"); game.say(\"Portal is off!\"); } return; } if (id === \"ball\" || tags.includes(\"ball\")) { if (!portalOn) { game.sound(\"boing\"); game.say(\"The portal is off! Tap the bolt first.\"); return; } const balls = game.find(\"ball\"); const currentBall = balls.length > 0 ? balls[0] : e.target; const destination = currentBall.x < 8 ? PAD_RIGHT : PAD_LEFT; game.move(\"ball\", destination); game.sound(\"whoosh\"); game.celebrate(\"sparkle\"); game.say(\"Zap! Teleported to the other pad!\"); } });",
