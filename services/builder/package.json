{
  "name": "@just-imagine/builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval": "tsx bin/evaluate.ts",
    "eval:offline": "tsx bin/evaluate.ts --mode double",
    "eval:vertex": "tsx bin/evaluate.ts --mode vertex --allow-cloud"
  },
  "dependencies": {
    "@just-imagine/protocol": "workspace:*",
    "@just-imagine/scene-schema": "workspace:*",
    "@just-imagine/server-core": "workspace:*",
    "@google/genai": "^1.29.0",
    "@google-cloud/storage": "^7.17.0",
    "fastify": "^5.6.0",
    "genkit": "^1.21.0",
    "google-auth-library": "^10.4.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.0",
    "firebase-admin": "^13.4.0",
    "ulid": "^3.0.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@just-imagine/fixtures": "workspace:*",
    "@just-imagine/game-runtime": "workspace:*"
  },
  "devDependencies": {
    "@just-imagine/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
